{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true,
    "declaration": true, "rootDir": "src", "outDir": "dist",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
